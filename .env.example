# Copie para .env.local para uso local. No deploy, configure no painel Vercel.
# Use uma senha longa e exclusiva (pelo menos 12 caracteres).
ADMIN_PASSWORD=
SESSION_SECRET=

# Obrigatório em produção (Vercel) para persistir as atualizações.
# Execute antes o SQL em supabase.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
